{
  "version": "1.1",
  "performance": {
    "odds_simulation_count": 3000,
    "fast_mode_simulation_count": 1000,
    "cache_enabled": true,
    "cache_max_size": 1000,
    "ai_thinking_time": 1.0,
    "ai_decision_variance": 0.1,
    "animation_speed": 1.0,
    "show_calculation_progress": true
  },
  "gameplay": {
    "small_blind": 5,
    "big_blind": 10,
    "initial_chips": 1000,
    "min_players": 2,
    "max_players": 6,
    "enable_side_pots": true,
    "enable_all_in_protection": true,
    "auto_muck_losing_hands": true,
    "tournament_mode": false,
    "blind_increase_interval": 0
  },
  "ai": {
    "skill_level": "intermediate",
    "enable_bluffing": true,
    "enable_learning": true,
    "enable_position_awareness": true,
    "style_weights": {
      "tight_aggressive": 0.3,
      "loose_aggressive": 0.2,
      "tight_passive": 0.2,
      "loose_passive": 0.15,
      "calling_station": 0.1,
      "maniac": 0.05
    }
  },
  "ui": {
    "show_odds_in_game": false,
    "show_opponent_strength": false,
    "confirm_simple_actions": false,
    "highlight_mistakes": false,
    "enable_hints": false,
    "show_ai_thinking": false,
    "language": "zh_CN",
    "use_emoji": true
  },
  "data": {
    "track_statistics": true,
    "max_history_records": 10000,
    "auto_backup_frequency": 100,
    "history_file": "game_history.json",
    "stats_file": "player_stats.json",
    "backup_directory": "backups",
    "compress_old_data": true,
    "data_retention_days": 365
  },
  "logging": {
    "log_level": "INFO",
    "log_to_file": true,
    "log_to_console": false,
    "log_file": "poker_game.log",
    "max_log_size_mb": 10,
    "max_log_files": 5
  },
  "developer": {
    "debug_mode": false,
    "enable_profiling": false,
    "enable_test_mode": false,
    "seed_random": null,
    "track_performance": false,
    "performance_log_interval": 1000
  }
}